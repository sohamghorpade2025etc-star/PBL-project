#include <iostream>
using namespace std;

int main() {
    int sum = 0;

    cout << "Even numbers between 1 and 50 are:" << endl;

    for (int i = 2; i <= 50; i += 2) {
        cout << i << " ";
        sum += i;
    }

    cout << "\n\nSum of even numbers between 1 and 50 = " << sum << endl;

    return 0;
}
