#include <iostream>
using namespace std;

class Complex
{
    float real, imag;

public:
    void accept()
    {
        cout << "Enter real part: ";
        cin >> real;

        cout << "Enter imaginary part: ";
        cin >> imag;
    }

    void display()
    {
        cout << real << " + " << imag << "i";
    }

    void operator-=(Complex c)
    {
        real = real - c.real;
        imag = imag - c.imag;
    }
};

int main()
{
    Complex c1, c2;

    cout << "Enter first complex number:" << endl;
    c1.accept();

    cout << "Enter second complex number:" << endl;
    c2.accept();

    c1 -= c2;

    cout << "Subtraction = ";
    c1.display();

    return 0;
}
