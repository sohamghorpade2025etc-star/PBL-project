#include <iostream>
#include <string>
using namespace std;

// Function template
template <class T>
T maximumValue(T a, T b)
{
    if (a > b)
        return a;
    else
        return b;
}

// Class template
template <class T>
class Box
{
    T value;

public:
    Box(T v)
    {
        value = v;
    }

    void display()
    {
        cout << "Box value = " << value << endl;
    }
};

int main()
{
    // Function template with int and double
    cout << "Maximum integer = " << maximumValue(15, 25) << endl;

    cout << "Maximum double = " << maximumValue(3.5, 5.5) << endl;

    // Class template with int
    Box<int> b1(100);
    b1.display();

    // Class template with string
    Box<string> b2("C++ Templates");
    b2.display();

    return 0;
}
